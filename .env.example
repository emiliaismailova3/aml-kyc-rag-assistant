# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM provider ---
# Which OpenAI-compatible provider to use for chat completions: groq | together | openai
# Defaults to Groq because it has a free tier with an OpenAI-compatible API,
# so the project runs end-to-end without a paid key.
LLM_PROVIDER=groq

# API key for the selected provider (only the one matching LLM_PROVIDER is required)
GROQ_API_KEY=
# TOGETHER_API_KEY=
# OPENAI_API_KEY=

# Base URL for the selected provider's OpenAI-compatible endpoint
GROQ_API_BASE=https://api.groq.com/openai/v1
# TOGETHER_API_BASE=https://api.together.xyz/v1
# OPENAI_API_BASE=https://api.openai.com/v1

# Chat model name for the selected provider. Groq decommissions/renames
# models over time -- if you get a 404 model_not_found, check your current
# available models at console.groq.com (as of writing: openai/gpt-oss-120b,
# openai/gpt-oss-20b, qwen/qwen3.8-27b).
LLM_MODEL=openai/gpt-oss-120b
# LLM_MODEL=meta-llama/Llama-3-70b-chat-hf # example for together
# LLM_MODEL=gpt-4o-mini                    # example for openai

# Optional: use a different model as the RAGAS judge (src/evaluate.py) than
# the one that answers questions. Useful if the main model's output breaks
# RAGAS's JSON-based scoring prompts. Defaults to LLM_MODEL if unset.
# EVAL_LLM_MODEL=qwen/qwen3.8-27b

# --- Embeddings ---
# Which embedding backend to use: local | openai
# Defaults to a local, free, no-API-key sentence-transformers model so
# ingestion/indexing/retrieval work with zero external dependencies.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=aml_kyc_knowledge_base

# --- Agent web search tool (step 7) ---
# Uses the free, keyless ddgs (DuckDuckGo) package by default -- no variable
# needed here. Left as a placeholder in case you swap in a paid search API.
# TAVILY_API_KEY=

# --- Optional: quieter/faster local embedding runs ---
# Skip Hugging Face Hub's "is there a newer version?" network check once the
# local embedding model is already cached locally (uncomment after your
# first successful `python -m src.vectorstore` run).
# HF_HUB_OFFLINE=1

# --- Reliability layer (src/llm_client.py) ------------------------------------
# Order of providers to try. A provider without an API key is skipped. Default: only LLM_PROVIDER.
# LLM_FALLBACK_CHAIN=openai,anthropic,groq
# ANTHROPIC_API_KEY=
# Optional per-provider models (main = long/complex prompts, small = short plain prompts):
# GROQ_SMALL_MODEL=openai/gpt-oss-20b
# OPENAI_MODEL=gpt-4o
# OPENAI_SMALL_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001
# Override the approximate price table (USD per 1M tokens: [input, output]):
# LLM_PRICES_JSON={"gpt-4o": [2.5, 10.0]}

# --- Database and vector backend ---------------------------------------------------
# chroma (default, local folder) | pgvector (PostgreSQL; needs DATABASE_URL)
# VECTOR_BACKEND=pgvector
# Empty -> a local SQLite file (logs/app.db). For the docker-compose database:
# DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant
# Read-only connection used by the agent's SQL tool (view access only):
# DATABASE_READONLY_URL=postgresql://assistant_ro:assistant_ro@localhost:5432/assistant

# --- Voice questions (POST /ask_voice) ------------------------------------------------
# local = faster-whisper on CPU (pip install -r requirements-voice.txt), openai = hosted Whisper API
# WHISPER_PROVIDER=local
# WHISPER_MODEL_SIZE=base     # tiny | base | small | medium (bigger = more accurate, slower)

# --- Collector (Celery + Redis) ---------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
# COLLECT_INTERVAL_MINUTES=360
# COLLECT_MIN_INTERVAL_SECONDS=5
