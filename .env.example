# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM provider ---
# Which OpenAI-compatible provider to use for chat completions: openai | groq | together
LLM_PROVIDER=openai

# API key for the selected provider
OPENAI_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=

# Base URL override (only needed for groq/together; openai uses the default)
# GROQ_API_BASE=https://api.groq.com/openai/v1
# TOGETHER_API_BASE=https://api.together.xyz/v1

# Chat model name for the selected provider
LLM_MODEL=gpt-4o-mini
# LLM_MODEL=llama-3.1-70b-versatile        # example for groq
# LLM_MODEL=meta-llama/Llama-3-70b-chat-hf # example for together

# --- Embeddings ---
# Which embedding backend to use: openai | local
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Local (free, no API key) fallback model, used when EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Vector store ---
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=aml_kyc_knowledge_base

# --- Optional: web search tool for the agent layer (step 7) ---
# TAVILY_API_KEY=
